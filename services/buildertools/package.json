  "license": "MIT",
  "name": "sneezymud-buildertools",
  "private": true,
  "scripts": {
    "build": "vite build",
    "check": "bun run --parallel typecheck lint format",
    "check:fix": "bun run typecheck && bun run lint:fix && bun run format:write",
    "dev": "trap 'kill 0' SIGINT SIGTERM; bun --watch src/server/index.ts & vite; wait",
    "dev:api": "bun --watch src/server/index.ts",
    "dev:web": "vite",
    "format": "prettier --check .",
    "format:write": "prettier --log-level silent --write .",
    "knip": "knip",
    "lint": "bun --bun eslint .",
    "lint:fix": "bun --bun eslint . --fix",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "test": "bun test --preload ./src/server/test-preload.ts src/server/ src/shared/ src/lib/ src/hooks/ src/components/code-editor/",
    "test:all": "bun run test && bun run test:components",
    "test:components": "bun test --preload ./src/test-preload-dom.ts .test.tsx",
    "test:e2e": "playwright test",
    "typecheck": "tsc"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "version": "0.1.0",
  "overrides": {
    "zod-validation-error": "$zod-validation-error"
  }
}
