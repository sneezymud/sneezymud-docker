  "scripts": {
    "build": "vite build",
    "check": "bun run typecheck && bun run lint && bun run format",
    "check:fix": "bun run typecheck && bun run lint:fix && bun run format:write",
    "dev": "trap 'kill 0' SIGINT SIGTERM; bun --watch src/server/index.ts & vite; wait",
    "dev:api": "bun --watch src/server/index.ts",
    "dev:web": "vite",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "bun --bun eslint .",
    "lint:fix": "bun --bun eslint . --fix",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "test": "bun test",
    "typecheck": "tsc"
